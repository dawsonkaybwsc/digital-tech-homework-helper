<Window x:Class="HomeworkHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomeworkHelper"
        mc:Ignorable="d"
        Title="Homework Helper" Height="750" Width="900">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
            <TextBlock Text="Homework Helper" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="#333333"/>
            
            <TextBlock Text="Select AI Model:" FontWeight="Medium" Margin="0,0,0,5" Foreground="#555555"/>
            <ComboBox Name="ModelComboBox" Height="32" Margin="0,0,0,15" SelectedIndex="0" VerticalContentAlignment="Center" FontSize="13">
                <ComboBoxItem Content="OpenRouter Free" Tag="openrouter/free"/>
                <ComboBoxItem Content="Nvidia Nemotron" Tag="nvidia/nemotron-3.5-lightning:free"/>
                <ComboBoxItem Content="North Mini" Tag="cohere/north-mini-code:free"/>
                <ComboBoxItem Content="MiniMax" Tag="minimax/minimax-m2.7:free"/>
            </ComboBox>

            <TextBlock Text="Enter your question:" FontWeight="Medium" Margin="0,0,0,5" Foreground="#555555"/>
            <TextBox Name="InputTextBox" Height="35" Padding="5" Margin="0,0,0,15" VerticalContentAlignment="Center" FontSize="13" KeyDown="InputTextBox_KeyDown"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Name="Submit" Content="Submit" Height="30" Width="140" Margin="0,0,0,20" Click="Submit_Click" FontSize="12" FontWeight="SemiBold"/>
                <Button Name="Reset" Content="Reset Conversation" Height="30" Width="140" Margin="10,0,0,20" Click="ClearHistory_Click" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            
            <TextBlock Text="Output:" FontWeight="Medium" Margin="0,0,0,5" Foreground="#555555"/>
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="#F5F5F5" CornerRadius="4" Padding="8" Height="280">
                <TextBox Name="OutputTextBox" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontSize="14" Foreground="#333333" Background="Transparent" BorderThickness="0" Text="Waiting for user response..."/> 
            </Border>
        </StackPanel>
    </Grid>
</Window>